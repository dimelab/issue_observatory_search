# Issue Observatory — environment template.
# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#
# docker-compose.yml reads this file twice: Compose itself interpolates the
# DB_*/PORT/VOLUME values below when building the stack, and each app service
# also loads it via env_file for the API keys.

# --- Application ---
APP_NAME="Issue Observatory Search"
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API ---
API_V1_PREFIX=/api
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:8080"]

# --- Security ---
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Compose builds the in-container DATABASE_URL from these, always pointing at the
# "postgres" service. DATABASE_URL below is only used when you run the app or the
# scripts directly on the host (note the port is DB_PORT_HOST, not 5432).
DB_USER=postgres
DB_PASSWORD=
DB_NAME=issue_observatory
DB_PORT_HOST=5433
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5433/issue_observatory

DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis / Celery ---
# In-container values are set by compose; this is the host-side equivalent.
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_PORT_HOST=6379

# --- Published ports ---
BACKEND_PORT_HOST=8080
FLOWER_PORT_HOST=5555

# --- Docker volumes ---
# Docker reuses a volume that already exists under these names and only creates
# one when missing. Point these at an existing volume to adopt its data.
POSTGRES_VOLUME_NAME=issue_observatory_postgres_data
REDIS_VOLUME_NAME=issue_observatory_redis_data
APP_VOLUME_NAME=issue_observatory_app_data

# --- Search engines (at least one required) ---
# Put values on their own line with no trailing comment: everything after the "="
# is part of the value, so an inline comment becomes part of the key and the
# provider answers 403.
# serper.dev, ~$2 per 1k searches
SERPER_API_KEY=
# Searches run in the search worker, in parallel, within what the Serper account allows
# (50 requests per second; requests are paced evenly at the rate below, so the receiver
# sees a little more in its busiest second). Each search waits ~30 s for Google, so many keywords run at
# once. Lower these if Serper answers 429 often.
#   SEARCH_WORKER_CONCURRENCY    searches (sessions) running at the same time, all users
#   SEARCH_MAX_ACTIVE_PER_USER   sessions one user searches at once; the rest wait their turn
#   SEARCH_CONCURRENCY           keywords at once within one session
#   SEARCH_GLOBAL_CONCURRENCY    keywords at once across all sessions and workers
#   SERPER_RESOLVE_CONCURRENCY   Serper /resolve requests in flight across all workers
#   SERPER_RATE_LIMIT_PER_SECOND requests per second to Serper across all workers
SEARCH_WORKER_CONCURRENCY=4
SEARCH_MAX_ACTIVE_PER_USER=1
SEARCH_CONCURRENCY=20
SEARCH_GLOBAL_CONCURRENCY=30
SERPER_RESOLVE_CONCURRENCY=60
SERPER_RATE_LIMIT_PER_SECOND=35
# A search that reports nothing for this long (seconds) lost its worker and is restarted by celery_beat
SEARCH_STALE_SECONDS=180
# Only for testing: send Serper requests to a fake Serper instead of google.serper.dev
# SERPER_BASE_URL=http://localhost:9000
# Google, ~$5 per 1k searches after 100/day free
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
# SerpAPI — a different service from Serper, with its own key
SERPAPI_KEY=

# --- LLM (optional, concept extraction) ---
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Storage ---
FILE_STORAGE_PATH=./data/exports
NETWORK_EXPORT_DIR=./data/networks

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_SEARCH_PER_MINUTE=10
RATE_LIMIT_SCRAPE_PER_MINUTE=5
RATE_LIMIT_NETWORK_PER_HOUR=5

# --- pgAdmin (only with --profile tools) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
